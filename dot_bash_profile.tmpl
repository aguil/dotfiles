# just(1): load static completions, then proj:: wrapper — must run *last* so
# ~/.extra, conda, and bash-completion's on-demand `just` loader cannot clobber
# `complete -F _just_with_proj_dynamic`. Re-assert on each prompt if something
# replaced the registration (some loaders reset to stock `_just` / `_clap_complete_just`).
_just_static_candidates=(
    "${HOME}/.local/share/bash-completion/completions/just"
    "${BREW_PREFIX:-}/share/bash-completion/completions/just"
    "${BREW_PREFIX:-}/etc/bash_completion.d/just"
)
for _justc in "${_just_static_candidates[@]}"; do
    if [ -r "$_justc" ]; then
        # shellcheck source=/dev/null
        . "$_justc"
        break
    fi
done
unset _justc _just_static_candidates
# If no on-disk completion file ran, define stock completer from the `just` on PATH
# (Homebrew/mise layouts vary; modern just uses `_clap_complete_just`, not `_just`).
if command -v just >/dev/null 2>&1; then
    if ! declare -F _just >/dev/null 2>&1 && ! declare -F _clap_complete_just >/dev/null 2>&1; then
        eval "$(JUST_COMPLETE=bash just)"
    fi
fi
if command -v chezmoi >/dev/null 2>&1 && command -v just >/dev/null 2>&1; then
    _jp_comp="$(chezmoi source-path 2>/dev/null)/scripts/just-proj-completion.bash"
    if [ -r "${_jp_comp:-}" ]; then
        # shellcheck source=/dev/null
        . "$_jp_comp"
    fi
    unset _jp_comp
fi
if [ -z "${_CHEZ_JUST_PROJ_PROMPT_INIT:-}" ]; then
    _chez_reassert_just_proj_completion() {
        command -v chezmoi >/dev/null 2>&1 || return 0
        local _p _c
        _p="$(chezmoi source-path 2>/dev/null)" || return 0
        _c="${_p}/scripts/just-proj-completion.bash"
        [ -r "$_c" ] || return 0
        if complete -p just 2>/dev/null | grep -qF '_just_with_proj_dynamic'; then
            return 0
        fi
        # shellcheck source=/dev/null
        . "$_c"
    }
    case $- in *i*)
        # Bash 5.1+ runs each indexed PROMPT_COMMAND element in order. 5.0 and
        # earlier accept array assignment but do not implement that semantics; use
        # a single scalar chain joined with ";" there instead.
        _chez_bash_prompt_arrays=0
        if [ "${BASH_VERSINFO[0]:-0}" -gt 5 ] 2>/dev/null \
            || { [ "${BASH_VERSINFO[0]:-0}" -eq 5 ] && [ "${BASH_VERSINFO[1]:-0}" -ge 1 ]; } 2>/dev/null; then
            _chez_bash_prompt_arrays=1
        fi
        _chez_pc_decl="$(declare -p PROMPT_COMMAND 2>/dev/null || true)"
        if [ -n "$_chez_pc_decl" ] \
            && { [ "${_chez_pc_decl#declare -a }" != "$_chez_pc_decl" ] \
                || [ "${_chez_pc_decl#declare -ax }" != "$_chez_pc_decl" ]; }; then
            if [ "$_chez_bash_prompt_arrays" = 1 ]; then
                PROMPT_COMMAND=(_chez_reassert_just_proj_completion "${PROMPT_COMMAND[@]}")
            else
                _chez_prompt_flat=
                for _chez_i in "${PROMPT_COMMAND[@]}"; do
                    [ -z "$_chez_prompt_flat" ] || _chez_prompt_flat="${_chez_prompt_flat};"
                    _chez_prompt_flat="${_chez_prompt_flat}${_chez_i}"
                done
                PROMPT_COMMAND="_chez_reassert_just_proj_completion;${_chez_prompt_flat}"
                unset _chez_i _chez_prompt_flat
            fi
        else
            # Prepend without leaving ";;" or ";…;" gaps. Some tools chain
            # PROMPT_COMMAND with a leading ";" when it was empty; combining
            # that with "${PROMPT_COMMAND:+;$PROMPT_COMMAND}" yields ";;" and
            # bash runs a no-name command (stderr: bash: command not found: ).
            _chez_prompt_rest="${PROMPT_COMMAND-}"
            while [ "${_chez_prompt_rest#;}" != "$_chez_prompt_rest" ]; do
                _chez_prompt_rest="${_chez_prompt_rest#;}"
            done
            while [ "${_chez_prompt_rest%;}" != "$_chez_prompt_rest" ]; do
                _chez_prompt_rest="${_chez_prompt_rest%;}"
            done
            while case "$_chez_prompt_rest" in *";;"*) true;; *) false;; esac; do
                _chez_prompt_rest="${_chez_prompt_rest//;;/;}"
            done
            _chez_prompt_rest="${_chez_prompt_rest#"${_chez_prompt_rest%%[![:space:]]*}"}"
            _chez_prompt_rest="${_chez_prompt_rest%"${_chez_prompt_rest##*[![:space:]]}"}"
            if [ "$_chez_bash_prompt_arrays" = 1 ]; then
                if [ -n "$_chez_prompt_rest" ]; then
                    PROMPT_COMMAND=(
                        _chez_reassert_just_proj_completion
                        "$_chez_prompt_rest"
                    )
                else
                    PROMPT_COMMAND=(_chez_reassert_just_proj_completion)
                fi
            else
                if [ -n "$_chez_prompt_rest" ]; then
                    PROMPT_COMMAND="_chez_reassert_just_proj_completion;${_chez_prompt_rest}"
                else
                    PROMPT_COMMAND=_chez_reassert_just_proj_completion
                fi
            fi
            unset _chez_prompt_rest
        fi
        unset _chez_pc_decl _chez_bash_prompt_arrays
        ;;
    esac
    _CHEZ_JUST_PROJ_PROMPT_INIT=1
fi
