# Repo-scoped gh(): personal forge host from chezmoi data, legacy GitHub personal tree, chezmoi source.

ghpersonalauth () {
  local config_dir
  local host="${CHEZMOI_GH_HOST:-github.com}"

  config_dir="$(_chez_gh_personal_config_dir)"

  mkdir -p "$config_dir"
  GH_CONFIG_DIR="$config_dir" command gh auth login -h "$host" -p ssh "$@"
  GH_CONFIG_DIR="$config_dir" command gh auth status -h "$host"
}

# The personal account's config dir on every profile. CHEZMOI_GH_CONFIG_DIR is
# the profile default, which is the work account on a work machine.
_chez_gh_personal_config_dir () {
  printf '%s\n' "${CHEZMOI_GH_PERSONAL_CONFIG_DIR:-$HOME/.config/gh-personal}"
}

# True when the repo's origin is on GitHub, including SSH host aliases such as
# git@github-aguil:owner/repo.git that resolve to (ssh.)github.com.
_chez_gh_origin_is_github () {
  local url
  local host

  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 1
  case "$url" in
    *://*)
      host="${url#*://}"
      host="${host#*@}"
      host="${host%%[:/]*}"
      ;;
    *:*)
      host="${url%%:*}"
      host="${host#*@}"
      ;;
    *) return 1 ;;
  esac
  case "$host" in
    github.com|*.github.com) return 0 ;;
  esac
  command -v ssh >/dev/null 2>&1 || return 1
  case "$(ssh -G "$host" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')" in
    github.com|*.github.com) return 0 ;;
  esac
  return 1
}

_chez_gh_route_config_dir () {
  local routes=""
  local route_file
  local root
  local config_dir

  gh_route () {
    [ -n "${1:-}" ] || return 0
    [ -n "${2:-}" ] || return 0
    routes="${routes}${routes:+
}$1|$2"
  }

  for route_file in "$HOME"/.config/chezmoi/gh-routes.d/*.sh; do
    [ -r "$route_file" ] || continue
    # shellcheck source=/dev/null
    . "$route_file"
  done
  unset -f gh_route 2>/dev/null || true

  while IFS='|' read -r root config_dir; do
    [ -n "$root" ] || continue
    [ -n "$config_dir" ] || continue
    case "$PWD/" in
      "$root"/*|"$root"/)
        printf '%s\n' "$config_dir"
        return 0
        ;;
    esac
  done <<< "$routes"

  return 1
}

gh () {
  local chezmoi_source
  local route_config_dir
  local gh_personal_github_repo_root="$HOME/dev/repos/github.com/{{ .git.personal.githubUser }}"

  if declare -F _chez_gh_route_config_dir >/dev/null 2>&1 \
    && route_config_dir="$(_chez_gh_route_config_dir)"; then
    GH_CONFIG_DIR="$route_config_dir" command gh "$@"
    return $?
  fi
  case "$PWD/" in
    "$gh_personal_github_repo_root"/*|"$gh_personal_github_repo_root"/)
      GH_HOST=github.com GH_CONFIG_DIR="$(_chez_gh_personal_config_dir)" command gh "$@"
      return $?
      ;;
  esac
  if command -v chezmoi >/dev/null 2>&1; then
    if chezmoi_source="$(chezmoi source-path 2>/dev/null)"; then
      case "$PWD/" in
        "$chezmoi_source"/*|"$chezmoi_source"/)
          if _chez_gh_origin_is_github "$chezmoi_source"; then
            GH_HOST=github.com GH_CONFIG_DIR="$(_chez_gh_personal_config_dir)" command gh "$@"
            return $?
          fi
          ;;
      esac
    fi
  fi

  command gh "$@"
}
