{{- if ne .chezmoi.os "windows" }}
# zoxide: replace cd with smart jumps in human shells. Agent subprocesses keep
# builtin cd and do not write to the zoxide database.

if [ -z "${INTELLIJ_ENVIRONMENT_READER:-}" ] && command -v zoxide >/dev/null 2>&1; then
  if type _is_agent_shell >/dev/null 2>&1 && _is_agent_shell; then
    :
  elif [ -n "${ZSH_VERSION:-}" ]; then
    eval "$(zoxide init zsh --cmd cd)"
  else
    eval "$(zoxide init bash --cmd cd)"
  fi
fi
{{- end }}
