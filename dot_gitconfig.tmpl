{{- $dotfilesGitDir := "~/projects/dotfiles/" -}}
{{- $personalGithubUser := .git.personal.name -}}
{{- if hasKey .git.personal "githubUser" -}}
{{- $personalGithubUser = .git.personal.githubUser -}}
{{- end -}}
{{- $personalReposGitDir := printf "~/dev/repos/github.com/%s/" $personalGithubUser -}}
{{- $personalCodebergUser := $personalGithubUser -}}
{{- if hasKey . "codeberg" -}}
{{- if hasKey .codeberg "user" -}}
{{- $personalCodebergUser = .codeberg.user -}}
{{- end -}}
{{- end -}}
{{- $codebergHost := "codeberg.org" -}}
{{- if hasKey . "codeberg" -}}
{{- if hasKey .codeberg "host" -}}
{{- $codebergHost = .codeberg.host -}}
{{- end -}}
{{- end -}}
{{- $personalForgeHost := $codebergHost -}}
{{- $personalForgeReposGitDir := printf "~/dev/repos/%s/%s/" $personalForgeHost $personalCodebergUser -}}
{{- $chezmoiSourceDir := trimSuffix "/" .chezmoi.sourceDir -}}
{{- $chezmoiSourceGitDir := printf "%s/" $chezmoiSourceDir -}}
{{- $windowsLocalAppData := replace "\\" "/" (env "LOCALAPPDATA") -}}
{{- $kdiff3Cmd := `kdiff3 "$LOCAL" "$REMOTE"` -}}
{{- if hasPrefix .chezmoi.homeDir .chezmoi.sourceDir -}}
{{- $chezmoiSourceGitDir = printf "%s/" (replace .chezmoi.homeDir "~" $chezmoiSourceDir) -}}
{{- end -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $kdiff3Cmd = `test -x "/Applications/kdiff3.app/Contents/MacOS/kdiff3" && "/Applications/kdiff3.app/Contents/MacOS/kdiff3" "$LOCAL" "$REMOTE" || kdiff3 "$LOCAL" "$REMOTE"` -}}
{{- end -}}
[alias]
    st = status
    ci = commit
    br = branch
    co = checkout
    diffc = diff --cached
    ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%an]" --decorate
    ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%an]" --decorate --numstat
    lnc = log --pretty=format:"%h\\ %s\\ [%an]"
    lds = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%an]" --decorate --date=short
    ld = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%an]" --decorate --date=relative
    switch = !legit switch "$@"
    branches = !legit branches
    sprout = !legit sprout "$@"
    unpublish = !legit unpublish "$@"
    harvest = !legit harvest "$@"
    sync = !legit sync "$@"
    publish = !legit publish "$@"
    graft = !legit graft "$@"
[branch]
    autosetupmerge = true
[color]
	ui = true
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[core]
    excludesfile = ~/.gitignore_global
    editor = vim -f
    whitespace = trailing-space,space-before-tab
    quotepath = false
    pager = delta
[interactive]
    diffFilter = delta --color-only
[difftool "kdiff3"]
    cmd = {{ $kdiff3Cmd }}
[init]
    templatedir = ~/.git_template
[merge]
    # Delta is a pager, not a merge UI; open diffview.nvim during conflicts (needs Neovim + diffview).
    tool = diffview
    keepBackup = false
    conflictStyle = zdiff3
[mergetool "diffview"]
    cmd = nvim -n -c "DiffviewOpen --selected-file=\"$MERGED\""
[rerere]
    enabled = true
[delta]
    line-numbers = true
    navigate = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
{{- if eq .chezmoi.os "darwin" }}
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
[commit]
    gpgsign = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
{{- if eq .chezmoi.os "darwin" }}
[credential]
    helper = osxkeychain
{{- else if and (eq .chezmoi.os "linux") (ne (env "WSL_DISTRO_NAME") "") }}
[core]
    sshCommand = /mnt/c/Windows/System32/OpenSSH/ssh.exe
[gpg "ssh"]
{{- if hasPrefix "/mnt/" $windowsLocalAppData }}
    program = "{{ $windowsLocalAppData }}/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
{{- else }}
    program = op-ssh-sign-wsl.exe
{{- end }}
[credential]
    helper = cache --timeout=7200
{{- else if eq .chezmoi.os "windows" }}
[core]
    sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
[gpg "ssh"]
{{- if ne $windowsLocalAppData "" }}
    program = "{{ $windowsLocalAppData }}/Microsoft/WindowsApps/op-ssh-sign.exe"
{{- else }}
    program = op-ssh-sign.exe
{{- end }}
[credential]
    helper = manager
{{- else }}
[credential]
    helper = cache --timeout=7200
{{- end }}

[include]
    path = ~/.gitconfig-{{ .profile }}

[includeIf "gitdir:{{ $dotfilesGitDir }}"]
    path = ~/.gitconfig-personal
[includeIf "gitdir/i:{{ $dotfilesGitDir }}"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:{{ $personalReposGitDir }}"]
    path = ~/.gitconfig-personal
[includeIf "gitdir/i:{{ $personalReposGitDir }}"]
    path = ~/.gitconfig-personal
{{- if ne $personalForgeHost "github.com" }}
[includeIf "gitdir:{{ $personalForgeReposGitDir }}"]
    path = ~/.gitconfig-personal
[includeIf "gitdir/i:{{ $personalForgeReposGitDir }}"]
    path = ~/.gitconfig-personal
{{- end }}
[includeIf "gitdir:{{ $chezmoiSourceGitDir }}"]
    path = ~/.gitconfig-personal
[includeIf "gitdir/i:{{ $chezmoiSourceGitDir }}"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:{{ $chezmoiSourceGitDir }}"]
    path = ~/.gitconfig-chezmoi
[includeIf "gitdir/i:{{ $chezmoiSourceGitDir }}"]
    path = ~/.gitconfig-chezmoi
[includeIf "gitdir:{{ $dotfilesGitDir }}"]
    path = ~/.gitconfig-chezmoi
[includeIf "gitdir/i:{{ $dotfilesGitDir }}"]
    path = ~/.gitconfig-chezmoi
