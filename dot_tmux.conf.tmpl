set-option -g default-shell "$SHELL"

# Ergonomics and quality-of-life.
set-option -g history-limit 100000
set-option -g mouse on
set-option -g focus-events on
# Let terminal graphics protocols pass through tmux for tools like image.nvim.
set-option -g allow-passthrough all
set-option -g visual-activity off
set-option -g renumber-windows on
set-option -g set-clipboard on
set-option -g allow-rename off
set-window-option -g automatic-rename off
set-option -g set-titles on
set-option -g set-titles-string "#{session_name}:#{window_name}"
set-option -sg escape-time 0

# Terminal defaults with truecolor support.
set-option -g default-terminal "tmux-256color"
set-option -ga terminal-overrides ",xterm-256color:Tc"
set-option -as terminal-overrides ',xterm-256color:RGB,TC,Sxl'
set-option -as terminal-overrides ',tmux-256color:RGB,TC,Sxl'

# Helps Meta/arrow sequences in xterm-compatible terminals (iTerm2, Kitty, Ghostty).
# Enables Option-based bindings below when the GUI app sends Esc-prefixed keys.
set-option -gw xterm-keys on
# Enable extended key reporting so Ghostty can pass Shift-Return and other
# modifier-aware keys through tmux as CSI-u sequences.
set-option -g extended-keys on
set-option -g extended-keys-format csi-u

# Use vi-style keys in copy mode.
setw -g mode-keys vi
bind-key -T copy-mode-vi -N "Begin character selection" v send-keys -X begin-selection
bind-key -T copy-mode-vi -N "Begin line selection" V send-keys -X select-line
bind-key -T copy-mode-vi -N "Toggle rectangle selection" C-v send-keys -X rectangle-toggle
bind-key -T copy-mode-vi -N "Leave copy mode" Escape send-keys -X cancel

# Clipboard integration.
if-shell "command -v pbcopy >/dev/null 2>&1" \
  "bind-key -T copy-mode-vi -N 'Copy selection to system clipboard' y send-keys -X copy-pipe-and-cancel 'pbcopy'" \
  "bind-key -T copy-mode-vi -N 'Copy selection to tmux buffer' y send-keys -X copy-selection-and-cancel"

if-shell "command -v pbpaste >/dev/null 2>&1" \
  "bind-key -N 'Paste from system clipboard' P run-shell 'tmux set-buffer -- \"$(pbpaste)\"; tmux paste-buffer'"

if-shell "command -v pbcopy >/dev/null 2>&1" \
  "bind-key -N 'Copy top tmux buffer to system clipboard' Y run-shell 'tmux save-buffer - | pbcopy'"

# Rebind pane splits to keep current working directory.
unbind '"'
unbind %
bind -N 'Split pane below (keep cwd)' '"' split-window -v -c "#{pane_current_path}"
bind -N "Split pane right (keep cwd)" % split-window -h -c "#{pane_current_path}"

# Quick config reload and scrollback clear.
bind-key -N "Reload tmux config" r source-file ~/.tmux.conf \; display-message "tmux config reloaded"
bind-key -N "Clear screen and scrollback" b send-keys -R \; clear-history
# Use explicit choose-tree shortcuts so sessions after 9 use plain letters.
# tmux's default Meta-letter shortcuts can be swallowed by terminal settings.
bind-key -N "Choose session (0-9, then letters)" s choose-tree -sZ -K "#{?#{==:#{line},0},0,#{?#{==:#{line},1},1,#{?#{==:#{line},2},2,#{?#{==:#{line},3},3,#{?#{==:#{line},4},4,#{?#{==:#{line},5},5,#{?#{==:#{line},6},6,#{?#{==:#{line},7},7,#{?#{==:#{line},8},8,#{?#{==:#{line},9},9,#{?#{==:#{line},10},a,#{?#{==:#{line},11},b,#{?#{==:#{line},12},c,#{?#{==:#{line},13},d,#{?#{==:#{line},14},e,#{?#{==:#{line},15},g,#{?#{==:#{line},16},i,#{?#{==:#{line},17},o,#{?#{==:#{line},18},p,#{?#{==:#{line},19},u,}}}}}}}}}}}}}}}}}}}}"
bind-key -N "Choose window from tree" w choose-tree -wZ

# Neovim-aware pane switching (no prefix; -n).
#
# macOS / terminal conflicts:
#   • C-h — often ASCII backspace before tmux sees it (classic tty behavior).
#   • C-j — newline in several stacks.
#   • C-l — Bash/zsh Emacs mode "clear screen" (readline); steals from tmux if the
#           shell consumes the keystroke first (focus must be tmux pane, not popup).
#   • Default tmux prefix is C-b — same as readline backward-char (Emacs editing).
#
# Neovim handles pane escape with christoomey/vim-tmux-navigator; tmux only owns
# these keys outside Neovim. When keys still disappear, try iTerm/Ghostty "Report
# modifiers using CSI u" style options, disable Secure Keyboard Entry while
# testing, or rely on prefix + hjkl instead of bare C-hjkl.
is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+/)?g?(view|n?vim?x?)(diff)?$'"
bind -n -N "Focus pane left (vim-aware)" C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind -n -N "Focus pane below (vim-aware)" C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind -n -N "Focus pane above (vim-aware)" C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind -n -N "Focus pane right (vim-aware)" C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"
bind -n -N "Focus last pane (vim-aware)" C-\\ if-shell "$is_vim" "send-keys C-\\" "select-pane -l"

# Prefix pane movement and pane resizing (tmux default prefix is usually C-b).
#
# Resize defaults: Shift+HJKL — on macOS, IME / accessibility / some host shortcuts can
# eat chorded Shift keys before tmux receives them.
#
# Alternatives (same repeat-time): prefix + Ctrl+h/j/k/l resize by 5 cells (no Shift).
# Alternative: prefix + Alt/Option+h/j/k/l — works when the GUI terminal maps Option to
# Meta + key (iTerm: Keys → Left Option → Esc+; Kitty: macos_option_as_alt).
bind -r -N "Select pane left" h select-pane -L
bind -r -N "Select pane below" j select-pane -D
bind -r -N "Select pane above" k select-pane -U
bind -r -N "Select pane right" l select-pane -R
bind -r -N "Resize pane left by 5" H resize-pane -L 5
bind -r -N "Resize pane down by 5" J resize-pane -D 5
bind -r -N "Resize pane up by 5" K resize-pane -U 5
bind -r -N "Resize pane right by 5" L resize-pane -R 5
bind-key -r -N "Resize pane left by 5 (no Shift)" C-h resize-pane -L 5
bind-key -r -N "Resize pane down by 5 (no Shift)" C-j resize-pane -D 5
bind-key -r -N "Resize pane up by 5 (no Shift)" C-k resize-pane -U 5
bind-key -r -N "Resize pane right by 5 (no Shift)" C-l resize-pane -R 5
bind-key -r -N "Resize pane left by 5 (Option/Meta)" M-h resize-pane -L 5
bind-key -r -N "Resize pane down by 5 (Option/Meta)" M-j resize-pane -D 5
bind-key -r -N "Resize pane up by 5 (Option/Meta)" M-k resize-pane -U 5
bind-key -r -N "Resize pane right by 5 (Option/Meta)" M-l resize-pane -R 5

# Manually tile panes on demand.
bind-key -N "Tile panes evenly" t select-layout tiled

# Help: searchable key bindings and a curated cheatsheet (tmux-help.sh in
# ~/.local/bin). `?` replaces the default raw list-keys view with an fzf
# search over binding notes; `/` replaces describe-key (rarely used — still
# available via customize-mode, prefix + C) with the cheatsheet popup.
bind-key -N "Search key bindings" ? display-popup -E -w 90% -h 90% "tmux-help.sh keys"
bind-key -N "Show tmux cheatsheet" / display-popup -E -w 100 -h 90% "tmux-help.sh cheatsheet"

# TPM plugin stack: sensible defaults + session/window tools.
set-option -g @plugin "tmux-plugins/tpm"
set-option -g @plugin "tmux-plugins/tmux-sensible"
set-option -g @plugin "tmux-plugins/tmux-resurrect"
set-option -g @plugin "tmux-plugins/tmux-continuum"
set-option -g @plugin "sainnhe/tmux-fzf"
set-option -g @plugin "aguil/tmux-tmuxr"

# Persist and restore sessions/window/pane state automatically.
set-option -g @continuum-restore "on"
set-option -g @continuum-save-interval "10"
set-option -g @resurrect-capture-pane-contents "on"
# work reconciles agent state after restore; relaunch agents explicitly.
set-option -g @resurrect-processes "false"

# work agent workspace (tmux-tmuxr). Requires: npm install -g @aguil/work
# prefix + Shift+S — track session and scan agents; prefix + Shift+W — toggle sidebar.
#
# Sidebar session labels must match the prefix + s choose-tree -K alphabet above.
set-option -g @work-session-shortcut-keys "0123456789abcdegiopu"
set-option -g @work-session-shortcut-index choose-order

# Install plugins with: prefix + I
run "~/.tmux/plugins/tpm/tpm"

# Paste clipboard image into agent prompt (prefix + p). Injects @path via run-shell.
bind-key -N "Paste clipboard image into agent prompt" p run-shell "paste-image-agent.sh --inject '#{pane_id}'"

# Tokyo Night status line (native).
#
# Replaces janoamaral/tokyo-night-tmux. That plugin composes status-right
# unconditionally and pushes each widget's enable check inside the widget
# script, so a disabled widget still costs a bash fork per refresh and several
# emit "invalid option: ..." on stderr because their guards call
# `tmux show-option -gv` unguarded. Every widget it ships was disabled here, so
# ~30 forks per redraw rendered an empty status-right.
#
# Everything below is tmux format expansion — no subshells. That also avoids
# tmux#3352, where redraw latency scales with scrollback size when the status
# line contains #() jobs (history-limit above is 100000).
#
# Set after `run tpm` so plugin load order cannot clobber it.

# Palette: tokyonight "night", matching dot_config/nvim/init.lua.
set-option -g @tn_bg "#1A1B26"
set-option -g @tn_fg "#a9b1d6"
set-option -g @tn_black "#414868"
set-option -g @tn_bblack "#2A2F41"
set-option -g @tn_blue "#7aa2f7"
set-option -g @tn_green "#73daca"
set-option -g @tn_bgreen "#41a6b5"
set-option -g @tn_yellow "#e0af68"

set-option -g status-style "bg=#{@tn_bg}"
set-option -g status-left-length 80
set-option -g status-right-length 150
set-option -g status-justify left
set-option -g window-status-separator ""

set-option -g mode-style "fg=#{@tn_bgreen},bg=#{@tn_bblack}"
set-option -g message-style "fg=#{@tn_bblack},bg=#{@tn_blue}"
set-option -g message-command-style "fg=#{@tn_blue},bg=#{@tn_bblack}"
set-option -g pane-border-style "fg=#{@tn_bblack}"
set-option -g pane-active-border-style "fg=#{@tn_blue}"
set-option -g pane-border-status off
set-option -g popup-border-style "fg=#{@tn_blue}"

# Session pill. Prefix-active swaps the glyph, matching the plugin's behaviour.
set-option -g status-left "#[fg=#{@tn_bblack},bg=#{@tn_blue},bold] #{?client_prefix,󰠠 ,#[dim]󰤂 }#[bold,nodim]#S#[nodim,fg=#{@tn_black}]@#h "

# Window tabs. #I/#P replace the plugin's custom-number.sh, which was set to
# "none" (plain digits) for window, pane, and zoom IDs alike — so zoomed and
# unzoomed panes rendered identically there. The 󰊓 marker restores that lost
# distinction. Multi-digit indices lose the inter-digit space the script
# emitted ("1 0 " becomes "10 "); renumber-windows is on and sessions here stay
# single-digit.
set-option -g window-status-format "#[fg=#{@tn_fg},bg=#{@tn_bg},nobold,noitalics,nounderscore,nodim] #{?#{==:#{pane_current_command},ssh},󰣀 ,  }#I #W#[nobold,dim] #{?window_zoomed_flag,󰊓 ,}#P #[fg=#{@tn_yellow}]#{?window_last_flag,󰁯  , }"
set-option -g window-status-current-format "#[fg=#{@tn_green},bg=#{@tn_bblack},nobold,noitalics,nounderscore,nodim] #{?#{==:#{pane_current_command},ssh},󰣀 ,  }#[fg=#{@tn_fg},bold,nodim]#I #W#[nobold] #{?window_zoomed_flag,#[fg=#{@tn_yellow}]󰊓 #[fg=#{@tn_fg}],}#P "

# work agent counts (tmux-tmuxr). Nothing else owns status-right now, so the
# README's `set -g` form applies. Keep the unquoted ~ path: tmuxr's one-time
# teardown strips only the absolute-path literal its old injector wrote.
set-option -g status-right "#[fg=#{@tn_fg},bg=#{@tn_bg}]#(bash ~/.tmux/plugins/tmux-tmuxr/scripts/status.sh) "

# Clock, if wanted. tmux expands strftime itself, so this costs no fork. The
# plugin's datetime widget was disabled, so it is left off for parity.
# set-option -ga status-right "#[fg=#{@tn_fg},bg=#{@tn_bblack}] %Y-%m-%d ❬ %H:%M "
