
. "$HOME/.local/bin/env"
{{- if eq .chezmoi.os "windows" }}
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
{{- end }}
export CHEZMOI_GH_HOST='{{ if hasKey . "gh" }}{{ .gh.host }}{{ else if ne (env "CHEZMOI_GH_HOST") "" }}{{ env "CHEZMOI_GH_HOST" }}{{ else }}github.com{{ end }}'
export CHEZMOI_GH_CONFIG_DIR="${CHEZMOI_GH_CONFIG_DIR:-$HOME/.config/gh-personal}"
export AI_TERM_CMD="opencode"

{{- if eq .profile "personal" }}
export CHEZMOI_GH_TOKEN_OP_REF='{{ if hasKey . "gh" }}{{ .gh.tokenOpRef }}{{ else }}{{ env "CHEZMOI_GH_TOKEN_OP_REF" }}{{ end }}'
{{- end }}

{{- if ne .chezmoi.os "windows" }}
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
  if [ -z "${__MISE_EXE:-}" ]; then
    __MISE_EXE="$(whence -p mise 2>/dev/null || true)"
  fi
  if [ -n "${__MISE_EXE:-}" ]; then
    export __MISE_EXE
  fi
fi
if [ -z "${INTELLIJ_ENVIRONMENT_READER:-}" ] && [ -f "$HOME/.config/oh-my-posh/shell-init.sh" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.config/oh-my-posh/shell-init.sh" zsh
fi
{{- end }}

oprompt () {
  local chezmoi_source
  local script_path

  if ! command -v chezmoi >/dev/null 2>&1; then
    printf 'oprompt: chezmoi is not installed.\n' >&2
    return 1
  fi

  if ! chezmoi_source="$(chezmoi source-path 2>/dev/null)"; then
    printf 'oprompt: unable to determine chezmoi source path.\n' >&2
    return 1
  fi

  script_path="$chezmoi_source/scripts/oprompt.sh"
  if [ ! -x "$script_path" ]; then
    printf 'oprompt: missing executable script: %s\n' "$script_path" >&2
    return 1
  fi

  "$script_path" "$@"
}

aprompt () {
  oprompt "$@"
}

if [[ -d "$HOME/.config/chezmoi/profile.d" ]]; then
  for _chez_profile_d in "$HOME"/.config/chezmoi/profile.d/*.sh(N); do
    [[ -r "$_chez_profile_d" ]] || continue
    # shellcheck source=/dev/null
    . "$_chez_profile_d"
  done
  unset _chez_profile_d
fi

ghpersonalauth () {
  local config_dir
  config_dir="${CHEZMOI_GH_CONFIG_DIR:-$HOME/.config/gh-personal}"

  mkdir -p "$config_dir"
  GH_CONFIG_DIR="$config_dir" command gh auth login -h github.com -p ssh "$@"
  GH_CONFIG_DIR="$config_dir" command gh auth status
}

_chez_gh_route_config_dir () {
  local routes=""
  local route_file
  local root
  local config_dir

  gh_route () {
    [[ -n "${1:-}" ]] || return 0
    [[ -n "${2:-}" ]] || return 0
    routes="${routes}${routes:+
}$1|$2"
  }

  for route_file in "$HOME"/.config/chezmoi/gh-routes.d/*.sh(N); do
    [[ -r "$route_file" ]] || continue
    # shellcheck source=/dev/null
    . "$route_file"
  done
  unfunction gh_route 2>/dev/null || true

  while IFS='|' read -r root config_dir; do
    [[ -n "$root" ]] || continue
    [[ -n "$config_dir" ]] || continue
    case "$PWD/" in
      "$root"/*|"$root"/)
        printf '%s\n' "$config_dir"
        return 0
        ;;
    esac
  done <<< "$routes"

  return 1
}

gh () {
  local chezmoi_source
  local route_config_dir
  local gh_personal_repo_root="$HOME/dev/repos/github.com/aguil"

  if [ -z "${GH_CONFIG_DIR:-}" ]; then
    if route_config_dir="$(_chez_gh_route_config_dir)"; then
      GH_CONFIG_DIR="$route_config_dir" command gh "$@"
      return $?
    fi
    case "$PWD/" in
      "$gh_personal_repo_root"/*|"$gh_personal_repo_root"/)
        GH_CONFIG_DIR="$CHEZMOI_GH_CONFIG_DIR" command gh "$@"
        return $?
        ;;
    esac
    if command -v chezmoi >/dev/null 2>&1; then
      if chezmoi_source="$(chezmoi source-path 2>/dev/null)"; then
        case "$PWD/" in
          "$chezmoi_source"/*|"$chezmoi_source"/)
            GH_CONFIG_DIR="$CHEZMOI_GH_CONFIG_DIR" command gh "$@"
            return $?
            ;;
        esac
      fi
    fi
  fi

  command gh "$@"
}

tmuxdev () {
  local chezmoi_source
  local script_path

  if ! command -v tmux >/dev/null 2>&1; then
    printf 'tmuxdev: tmux is not installed.\n' >&2
    return 1
  fi

  if ! command -v chezmoi >/dev/null 2>&1; then
    printf 'tmuxdev: chezmoi is not installed.\n' >&2
    return 1
  fi

  if ! chezmoi_source="$(chezmoi source-path 2>/dev/null)"; then
    printf 'tmuxdev: unable to determine chezmoi source path.\n' >&2
    return 1
  fi

  script_path="$chezmoi_source/scripts/tmux-dev-session.sh"
  if [ ! -x "$script_path" ]; then
    printf 'tmuxdev: missing executable script: %s\n' "$script_path" >&2
    return 1
  fi

  "$script_path" "$@"
}
# just(1): stock completions (bash/clap API) then proj::* wrapper (bashcompinit).
if [[ -z "${INTELLIJ_ENVIRONMENT_READER:-}" ]] && command -v just >/dev/null 2>&1; then
  # bashcompinit's `complete` needs compdef from compinit when nothing else loaded it.
  if ! (( ${+functions[compdef]} )); then
    autoload -Uz compinit 2>/dev/null && compinit -i -C 2>/dev/null
  fi
  autoload -Uz bashcompinit 2>/dev/null && bashcompinit -i 2>/dev/null
  if ! typeset -f _just >/dev/null 2>&1 && ! typeset -f _clap_complete_just >/dev/null 2>&1; then
    eval "$(JUST_COMPLETE=bash just)"
  fi
fi
if [[ -z "${INTELLIJ_ENVIRONMENT_READER:-}" ]] && command -v chezmoi >/dev/null 2>&1 && command -v just >/dev/null 2>&1; then
  _jp_comp="$(chezmoi source-path 2>/dev/null)/scripts/just-proj-completion.bash"
  if [[ -r "${_jp_comp:-}" ]]; then
    autoload -Uz bashcompinit 2>/dev/null && bashcompinit -i 2>/dev/null
    # shellcheck source=/dev/null
    . "$_jp_comp"
  fi
  unset _jp_comp
fi

if [[ -z "${_CHEZ_JUST_PROJ_ZSH_PRECMD_INIT:-}" ]] && [[ -z "${INTELLIJ_ENVIRONMENT_READER:-}" ]] && command -v chezmoi >/dev/null 2>&1; then
  _chez_reassert_just_proj_completion_zsh() {
    local _p _c
    _p="$(chezmoi source-path 2>/dev/null)" || return 0
    _c="${_p}/scripts/just-proj-completion.bash"
    [[ -r "$_c" ]] || return 0
    if complete -p just 2>/dev/null | command grep -qF '_just_with_proj_dynamic'; then
      return 0
    fi
    autoload -Uz bashcompinit 2>/dev/null && bashcompinit -i 2>/dev/null
    # shellcheck source=/dev/null
    . "$_c"
  }
  precmd_functions+=(_chez_reassert_just_proj_completion_zsh)
  _CHEZ_JUST_PROJ_ZSH_PRECMD_INIT=1
fi

if [[ -o interactive ]] && [[ -z "${INTELLIJ_ENVIRONMENT_READER:-}" ]] && [[ -z "${_CHEZ_AGENTS_SYNC_SHELL_HINT:-}" ]] && command -v chezmoi >/dev/null 2>&1 && command -v bash >/dev/null 2>&1; then
  _cz_as="$(chezmoi source-path 2>/dev/null)/scripts/agents-sync-hint.sh"
  if [[ -r "${_cz_as:-}" ]]; then
    bash "$_cz_as" shell-once || true
  fi
  export _CHEZ_AGENTS_SYNC_SHELL_HINT=1
  unset _cz_as
fi
