#!/usr/bin/env bash
set -euo pipefail

vocab_dir="{{ .chezmoi.homeDir }}/.config/vale/styles/config/vocabularies/Dotfiles"
host_base="$vocab_dir/accept.base.txt"
host_work="$vocab_dir/accept.work.txt"
target="$vocab_dir/accept.txt"

if [ ! -f "$host_base" ]; then
    printf 'vale-vocab-merge: missing managed base terms: %s\n' "$host_base" >&2
    exit 1
fi

# Find a working Python interpreter.  On Windows the `python3` App Execution
# Alias stub prints "Python was not found" and exits 9009 (bash sees 49), so
# verify the candidate actually runs before accepting it.
_find_python() {
    for py in python3 python; do
        if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys" 2>/dev/null; then
            printf '%s' "$py"
            return 0
        fi
    done
    return 1
}

if ! python_cmd="$(_find_python)"; then
    printf 'vale-vocab-merge: no working Python interpreter found; skipping merge.\n' >&2
    exit 0
fi

mkdir -p "$vocab_dir"
tmp_target="$(mktemp)"
trap 'rm -f "$tmp_target"' EXIT

"$python_cmd" - "$host_base" "$host_work" "$tmp_target" <<'PY'
from pathlib import Path
import sys

host_base, host_work, tmp_target = map(Path, sys.argv[1:])

def merged(paths):
    seen = set()
    output = []
    for path in paths:
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            if not line:
                if output and output[-1] != "":
                    output.append("")
                continue
            if line.startswith("#"):
                if line not in output:
                    output.append(line)
                continue
            if line in seen:
                continue
            seen.add(line)
            output.append(line)
    return "\n".join(output).rstrip() + "\n"

tmp_target.write_text(merged([host_base, host_work]))
PY

if [ ! -f "$target" ] || ! cmp -s "$tmp_target" "$target"; then
    cp "$tmp_target" "$target"
fi
