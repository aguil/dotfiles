#!/usr/bin/env bash
set -euo pipefail

vocab_dir="{{ .chezmoi.homeDir }}/.config/vale/styles/config/vocabularies/Dotfiles"
source_base="{{ .chezmoi.sourceDir }}/dot_config/vale/styles/config/vocabularies/Dotfiles/accept.base.txt"
host_base="$vocab_dir/accept.base.txt"
host_work="$vocab_dir/accept.work.txt"
target="$vocab_dir/accept.txt"

if [ ! -f "$source_base" ]; then
    printf 'vale-vocab-merge: missing base terms: %s\n' "$source_base" >&2
    exit 1
fi

mkdir -p "$vocab_dir"
tmp_base="$(mktemp)"
tmp_target="$(mktemp)"
trap 'rm -f "$tmp_base" "$tmp_target"' EXIT

python3 - "$host_base" "$source_base" "$tmp_base" "$target" "$host_work" "$tmp_target" <<'PY'
from pathlib import Path
import sys

host_base, source_base, tmp_base, target, host_work, tmp_target = map(Path, sys.argv[1:])

def merged(paths):
    seen = set()
    output = []
    for path in paths:
        if not path.exists():
            continue
        for line in path.read_text().splitlines():
            if not line:
                if output and output[-1] != "":
                    output.append("")
                continue
            if line.startswith("#"):
                if line not in output:
                    output.append(line)
                continue
            if line in seen:
                continue
            seen.add(line)
            output.append(line)
    return "\n".join(output).rstrip() + "\n"

tmp_base.write_text(merged([host_base, source_base]))
tmp_target.write_text(merged([tmp_base, host_work]))
PY

if [ ! -f "$host_base" ] || ! cmp -s "$tmp_base" "$host_base"; then
    cp "$tmp_base" "$host_base"
fi

if [ ! -f "$target" ] || ! cmp -s "$tmp_target" "$target"; then
    cp "$tmp_target" "$target"
fi
