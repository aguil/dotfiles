#!/usr/bin/env bash

{{- $isDarwin := eq .chezmoi.os "darwin" }}
{{- $isWindows := eq .chezmoi.os "windows" }}
{{- $personalCodebergKey := "~/.ssh/id_ed25519_codeberg" }}
{{- if and (hasKey . "ssh") (hasKey .ssh "personal") (hasKey .ssh.personal "codebergIdentityFile") }}
{{- if ne .ssh.personal.codebergIdentityFile "" }}
{{- $personalCodebergKey = .ssh.personal.codebergIdentityFile }}
{{- end }}
{{- else if $isDarwin }}
{{- $personalCodebergKey = "~/.ssh/id_ed25519_codeberg" }}
{{- else if $isWindows }}
{{- $personalCodebergKey = "~/.ssh/codeberg_ed25519" }}
{{- end }}

# Make sure the Codeberg SSH *public* key is on disk. The private key stays in
# 1Password: ssh reaches it through the 1Password agent (IdentityAgent on macOS
# and Windows, the relay in profile.d/06-wsl-ssh-agent.sh on WSL), and
# IdentitiesOnly needs only <identity file>.pub to pick that key. A private
# copy on disk would just be one more place for tools and agents to read it,
# so this script never writes one and only suggests removing an old copy.

set -euo pipefail

chezmoi_have_op() {
  command -v op >/dev/null 2>&1 || command -v op.exe >/dev/null 2>&1
}

chezmoi_op() {
  if command -v op >/dev/null 2>&1; then
    command op "$@"
  elif command -v op.exe >/dev/null 2>&1; then
    command op.exe "$@"
  else
    return 127
  fi
}

identity_file="{{ $personalCodebergKey }}"
identity_file="${identity_file/#\~/$HOME}"
pub_file="${identity_file}.pub"
ssh_key_op_ref="{{ if hasKey .codeberg "sshKeyOpRef" }}{{ .codeberg.sshKeyOpRef }}{{ else }}{{ env "CHEZMOI_CODEBERG_SSH_KEY_OP_REF" }}{{ end }}"

# codeberg.sshKeyOpRef names the item's "private key" field; read the item's
# "public key" field instead. A ref that already names "public key" works too.
public_key_op_ref="${ssh_key_op_ref%/private key}"
if [ "$public_key_op_ref" != "$ssh_key_op_ref" ]; then
  public_key_op_ref="${public_key_op_ref}/public key"
fi

if [ ! -s "$pub_file" ]; then
  mkdir -p "$(dirname "$pub_file")"
  if [ -f "$identity_file" ] && ssh-keygen -y -P '' -f "$identity_file" >"$pub_file" 2>/dev/null; then
    :
  elif [ "${public_key_op_ref%/public key}" != "$public_key_op_ref" ] && chezmoi_have_op &&
    public_key="$(chezmoi_op read "$public_key_op_ref" 2>/dev/null | tr -d '\r')" &&
    [ -n "$public_key" ]; then
    printf '%s\n' "$public_key" >"$pub_file"
  else
    rm -f "$pub_file"
    printf 'chezmoi: could not write %s; set codeberg.sshKeyOpRef and install the 1Password CLI (op, or op.exe on WSL) so ssh can find the Codeberg key in 1Password.\n' "$pub_file" >&2
  fi
  if [ -s "$pub_file" ]; then
    chmod 644 "$pub_file"
    printf 'chezmoi: wrote Codeberg SSH public key to %s.\n' "$pub_file"
  fi
fi

if [ -f "$identity_file" ]; then
  printf 'chezmoi: %s is a private key copy that 1Password already holds; consider removing it.\n' "$identity_file" >&2
fi
