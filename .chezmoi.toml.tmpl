{{- $choices := list "work" "personal" -}}
{{- $envProfile := env "CHEZMOI_PROFILE" -}}
{{- $profile := "" -}}
{{- if or (eq $envProfile "work") (eq $envProfile "personal") -}}
{{- $profile = $envProfile -}}
{{- else -}}
{{- $profile = promptChoiceOnce . "profile" "Select profile" $choices "personal" -}}
{{- end -}}
{{- $sourceRemote := trim (output "git" "-C" .chezmoi.sourceDir "remote" "get-url" "origin") -}}
{{- $sourceRemoteNoGit := trimSuffix ".git" $sourceRemote -}}
{{- $inferredPersonalGithubUser := "" -}}
{{- $inferredPersonalCodebergUser := "" -}}
{{- $inferredPersonalGhHost := "" -}}
{{- if hasPrefix "git@github.com:" $sourceRemoteNoGit -}}
{{- $inferredPersonalGithubUser = first (splitList "/" (trimPrefix "git@github.com:" $sourceRemoteNoGit)) -}}
{{- else if hasPrefix "git@codeberg.org:" $sourceRemoteNoGit -}}
{{- $inferredPersonalCodebergUser = first (splitList "/" (trimPrefix "git@codeberg.org:" $sourceRemoteNoGit)) -}}
{{- $inferredPersonalGhHost = "codeberg.org" -}}
{{- else if hasPrefix "git@" $sourceRemoteNoGit -}}
{{- $hostAndPath := splitList ":" (trimPrefix "git@" $sourceRemoteNoGit) -}}
{{- if eq (len $hostAndPath) 2 -}}
{{- if eq (index $hostAndPath 0) "github.com" -}}
{{- $inferredPersonalGithubUser = first (splitList "/" (index $hostAndPath 1)) -}}
{{- else if eq (index $hostAndPath 0) "codeberg.org" -}}
{{- $inferredPersonalCodebergUser = first (splitList "/" (index $hostAndPath 1)) -}}
{{- $inferredPersonalGhHost = "codeberg.org" -}}
{{- end -}}
{{- end -}}
{{- else if hasPrefix "ssh://git@github.com/" $sourceRemoteNoGit -}}
{{- $inferredPersonalGithubUser = first (splitList "/" (trimPrefix "ssh://git@github.com/" $sourceRemoteNoGit)) -}}
{{- else if hasPrefix "ssh://git@codeberg.org/" $sourceRemoteNoGit -}}
{{- $inferredPersonalCodebergUser = first (splitList "/" (trimPrefix "ssh://git@codeberg.org/" $sourceRemoteNoGit)) -}}
{{- $inferredPersonalGhHost = "codeberg.org" -}}
{{- else if hasPrefix "https://github.com/" $sourceRemoteNoGit -}}
{{- $inferredPersonalGithubUser = first (splitList "/" (trimPrefix "https://github.com/" $sourceRemoteNoGit)) -}}
{{- else if hasPrefix "https://codeberg.org/" $sourceRemoteNoGit -}}
{{- $inferredPersonalCodebergUser = first (splitList "/" (trimPrefix "https://codeberg.org/" $sourceRemoteNoGit)) -}}
{{- $inferredPersonalGhHost = "codeberg.org" -}}
{{- end -}}
{{- $envPersonalGithubUser := env "CHEZMOI_GIT_PERSONAL_USER" -}}
{{- $personalGithubUser := "" -}}
{{- if ne $envPersonalGithubUser "" -}}
{{- $personalGithubUser = $envPersonalGithubUser -}}
{{- else if ne $inferredPersonalGithubUser "" -}}
{{- $personalGithubUser = $inferredPersonalGithubUser -}}
{{- else -}}
{{- $personalGithubUser = promptStringOnce . "gitPersonalGithubUser" "Personal GitHub username for repo routing" "github-user" -}}
{{- end -}}
{{- $inferredPersonalName := trim (output "git" "-C" .chezmoi.sourceDir "log" "-1" "--format=%an") -}}
{{- $envPersonalName := env "CHEZMOI_GIT_PERSONAL_NAME" -}}
{{- $personalName := "" -}}
{{- if ne $envPersonalName "" -}}
{{- $personalName = $envPersonalName -}}
{{- else if ne $inferredPersonalName "" -}}
{{- $personalName = $inferredPersonalName -}}
{{- else -}}
{{- $personalName = promptStringOnce . "gitPersonalName" "Personal git author name" "Personal User" -}}
{{- end -}}
{{- $inferredPersonalEmail := trim (output "git" "-C" .chezmoi.sourceDir "log" "-1" "--format=%ae") -}}
{{- $envPersonalEmail := env "CHEZMOI_GIT_PERSONAL_EMAIL" -}}
{{- $personalEmail := "" -}}
{{- if ne $envPersonalEmail "" -}}
{{- $personalEmail = $envPersonalEmail -}}
{{- else if ne $inferredPersonalEmail "" -}}
{{- $personalEmail = $inferredPersonalEmail -}}
{{- else -}}
{{- $personalEmail = promptStringOnce . "gitPersonalEmail" "Personal git author email" "user@example.com" -}}
{{- end -}}
{{- $envPersonalGithubHostAlias := env "CHEZMOI_GIT_PERSONAL_HOST_ALIAS" -}}
{{- $personalGithubHostAlias := "" -}}
{{- if ne $envPersonalGithubHostAlias "" -}}
{{- $personalGithubHostAlias = $envPersonalGithubHostAlias -}}
{{- else if ne $personalGithubUser "" -}}
{{- $personalGithubHostAlias = printf "github-%s" $personalGithubUser -}}
{{- else -}}
{{- $personalGithubHostAlias = promptStringOnce . "gitPersonalGithubHostAlias" "Personal GitHub SSH host alias" "github-personal" -}}
{{- end -}}
{{- /* Reuse existing [data.codeberg] before prompting. The promptStringOnce
       fallbacks below key off root names this template never writes back into
       [data], so "Once" never engages; while origin was on Codeberg the
       prompts were simply unreachable because inference always won. With
       origin elsewhere, inference is empty and a configured machine would
       re-prompt (and fail non-interactively) on every init. */ -}}
{{- $existingCodebergUser := "" -}}
{{- $existingCodebergHost := "" -}}
{{- $existingCodebergTokenOpRef := "" -}}
{{- $existingCodebergSshKeyOpRef := "" -}}
{{- if hasKey . "codeberg" -}}
{{- if hasKey .codeberg "user" -}}{{- $existingCodebergUser = .codeberg.user -}}{{- end -}}
{{- if hasKey .codeberg "host" -}}{{- $existingCodebergHost = .codeberg.host -}}{{- end -}}
{{- if hasKey .codeberg "tokenOpRef" -}}{{- $existingCodebergTokenOpRef = .codeberg.tokenOpRef -}}{{- end -}}
{{- if hasKey .codeberg "sshKeyOpRef" -}}{{- $existingCodebergSshKeyOpRef = .codeberg.sshKeyOpRef -}}{{- end -}}
{{- end -}}
{{- $existingCodebergIdentityFile := "" -}}
{{- if and (hasKey . "ssh") (hasKey .ssh "personal") (hasKey .ssh.personal "codebergIdentityFile") -}}
{{- $existingCodebergIdentityFile = .ssh.personal.codebergIdentityFile -}}
{{- end -}}
{{- $envPersonalCodebergUser := env "CHEZMOI_GIT_CODEBERG_USER" -}}
{{- $personalCodebergUser := "" -}}
{{- if ne $envPersonalCodebergUser "" -}}
{{- $personalCodebergUser = $envPersonalCodebergUser -}}
{{- else if ne $inferredPersonalCodebergUser "" -}}
{{- $personalCodebergUser = $inferredPersonalCodebergUser -}}
{{- else if ne $existingCodebergUser "" -}}
{{- $personalCodebergUser = $existingCodebergUser -}}
{{- else -}}
{{- $personalCodebergUser = promptStringOnce . "gitPersonalCodebergUser" "Codeberg username for repo routing" "codeberg-user" -}}
{{- end -}}
{{- $defaultCodebergHost := "codeberg.org" -}}
{{- if ne $existingCodebergHost "" -}}
{{- $defaultCodebergHost = $existingCodebergHost -}}
{{- else if ne $inferredPersonalGhHost "" -}}
{{- $defaultCodebergHost = $inferredPersonalGhHost -}}
{{- end -}}
[data]
  profile = "{{ $profile }}"

[data.gh]
  host = "{{ if ne (env "CHEZMOI_GH_HOST") "" }}{{ env "CHEZMOI_GH_HOST" }}{{ else }}{{ promptStringOnce . "ghHost" "GitHub host for gh auth bootstrap" "github.com" }}{{ end }}"
  tokenOpRef = "{{ if eq $profile "personal" }}{{ if ne (env "CHEZMOI_GH_TOKEN_OP_REF") "" }}{{ env "CHEZMOI_GH_TOKEN_OP_REF" }}{{ else }}{{ promptStringOnce . "ghTokenOpRefPersonal" "1Password ref for personal GitHub CLI token" "op://Private/GitHub CLI/token" }}{{ end }}{{ else }}{{ env "CHEZMOI_GH_TOKEN_OP_REF" }}{{ end }}"

[data.codeberg]
  host = "{{ if ne (env "CHEZMOI_CODEBERG_HOST") "" }}{{ env "CHEZMOI_CODEBERG_HOST" }}{{ else if ne $existingCodebergHost "" }}{{ $existingCodebergHost }}{{ else }}{{ promptStringOnce . "codebergHost" "Codeberg hostname" $defaultCodebergHost }}{{ end }}"
  user = "{{ $personalCodebergUser }}"
  tokenOpRef = "{{ if eq $profile "personal" }}{{ if ne (env "CHEZMOI_CODEBERG_TOKEN_OP_REF") "" }}{{ env "CHEZMOI_CODEBERG_TOKEN_OP_REF" }}{{ else if ne $existingCodebergTokenOpRef "" }}{{ $existingCodebergTokenOpRef }}{{ else }}{{ promptStringOnce . "codebergTokenOpRefPersonal" "1Password ref for Codeberg API token (fj)" "op://Private/Codeberg/token" }}{{ end }}{{ else }}{{ env "CHEZMOI_CODEBERG_TOKEN_OP_REF" }}{{ end }}"
  sshKeyOpRef = "{{ if eq $profile "personal" }}{{ if ne (env "CHEZMOI_CODEBERG_SSH_KEY_OP_REF") "" }}{{ env "CHEZMOI_CODEBERG_SSH_KEY_OP_REF" }}{{ else if ne $existingCodebergSshKeyOpRef "" }}{{ $existingCodebergSshKeyOpRef }}{{ else }}{{ promptStringOnce . "codebergSshKeyOpRefPersonal" "1Password ref for Codeberg SSH private key" "op://Private/Codeberg SSH/private key" }}{{ end }}{{ else }}{{ env "CHEZMOI_CODEBERG_SSH_KEY_OP_REF" }}{{ end }}"

[data.ssh.personal]
  githubIdentityFile = "{{ env "CHEZMOI_SSH_PERSONAL_GITHUB_IDENTITY_FILE" }}"
  codebergIdentityFile = "{{ if ne (env "CHEZMOI_SSH_PERSONAL_CODEBERG_IDENTITY_FILE") "" }}{{ env "CHEZMOI_SSH_PERSONAL_CODEBERG_IDENTITY_FILE" }}{{ else if ne $existingCodebergIdentityFile "" }}{{ $existingCodebergIdentityFile }}{{ else }}{{ promptStringOnce . "sshPersonalCodebergIdentityFile" "Path to personal Codeberg SSH private key" "~/.ssh/id_ed25519_codeberg" }}{{ end }}"

[data.git.work]
  name = "Jason Aguilon"
  email = "jason.aguilon+github@workiva.com"
  signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINug+qOVAVEsSvjZTPp9TZw0BYjN23vdLKk3vME4e9sH"

[data.git.personal]
  name = "{{ $personalName }}"
  email = "{{ $personalEmail }}"
  signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIaFXxC3el9/it46KvnBpW313CcJz/r8hyE7anOqUiXr"
  githubUser = "{{ $personalGithubUser }}"
  githubHostAlias = "{{ $personalGithubHostAlias }}"

[data.tooling.personal]
  editors = ["opencode", "vscode"]

[diff]
  exclude = ["scripts"]
  pager = "delta"

# Git merge conflicts: use diffview.nvim via [mergetool "diffview"] in ~/.gitconfig.
# chezmoi merge passes three paths (destination / source / target); use builtin vimdiff (-d),
# not DiffviewOpen (that flow is Git-merge aware).
[merge]
  command = "nvim"
  args = [
    "-d",
    {{ printf "%q" "{{ .Destination }}" }},
    {{ printf "%q" "{{ .Source }}" }},
    {{ printf "%q" "{{ .Target }}" }},
  ]

[status]
  exclude = ["scripts"]

[verify]
  exclude = ["scripts"]

{{- if eq .chezmoi.os "windows" }}
[cd]
  command = "powershell"
  args = ["-NoLogo", "-NoExit"]

[interpreters.sh]
  command = "C:\\Program Files\\Git\\bin\\bash.exe"
{{- end }}
