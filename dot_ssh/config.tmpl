{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $personalGithubUser := .git.personal.name -}}
{{- if hasKey .git.personal "githubUser" -}}
{{- $personalGithubUser = .git.personal.githubUser -}}
{{- end -}}
{{- $personalGithubHostAlias := printf "github-%s" $personalGithubUser -}}
{{- if hasKey .git.personal "githubHostAlias" -}}
{{- $personalGithubHostAlias = .git.personal.githubHostAlias -}}
{{- end -}}
{{- $workGithubKey := "~/.ssh/id_ed25519" -}}
{{- /* Keep the fallback keyed on the resolved value, not on hasKey: chezmoi.toml
       may carry the entry with an empty string, and an else-if on the hasKey
       test would skip the platform default and leave the work key in place. */ -}}
{{- $personalGithubKey := "" -}}
{{- if and (hasKey . "ssh") (hasKey .ssh "personal") (hasKey .ssh.personal "githubIdentityFile") -}}
{{- $personalGithubKey = .ssh.personal.githubIdentityFile -}}
{{- end -}}
{{- if eq $personalGithubKey "" -}}
{{- if $isDarwin -}}
{{- $personalGithubKey = "~/.ssh/id_ed25519_aguil" -}}
{{- else if $isWindows -}}
{{- $personalGithubKey = "~/.ssh/aguil_ed25519" -}}
{{- else -}}
{{- $personalGithubKey = "~/.ssh/id_ed25519" -}}
{{- end -}}
{{- end -}}
{{- $personalCodebergKey := "" -}}
{{- if and (hasKey . "ssh") (hasKey .ssh "personal") (hasKey .ssh.personal "codebergIdentityFile") -}}
{{- $personalCodebergKey = .ssh.personal.codebergIdentityFile -}}
{{- end -}}
{{- if eq $personalCodebergKey "" -}}
{{- if $isWindows -}}
{{- $personalCodebergKey = "~/.ssh/codeberg_ed25519" -}}
{{- else -}}
{{- $personalCodebergKey = "~/.ssh/id_ed25519_codeberg" -}}
{{- end -}}
{{- end -}}
{{- $codebergHost := "codeberg.org" -}}
{{- if hasKey . "codeberg" -}}
{{- if hasKey .codeberg "host" -}}
{{- $codebergHost = .codeberg.host -}}
{{- end -}}
{{- end -}}
Host github.com
  HostName ssh.github.com
  Port 443
  User git
  {{- if eq .profile "work" }}
  IdentityFile {{ $workGithubKey }}
  {{- else }}
  IdentityFile {{ $personalGithubKey }}
  {{- end }}
  IdentitiesOnly yes
  HostKeyAlias github.com
  {{- if $isDarwin }}
  AddKeysToAgent yes
  UseKeychain yes
  {{- else if $isWindows }}
  IdentityAgent //./pipe/openssh-ssh-agent
{{- end }}

{{- if eq .profile "work" }}
Host {{ $personalGithubHostAlias }}
  HostName ssh.github.com
  Port 443
  User git
  IdentityFile {{ $personalGithubKey }}
  IdentitiesOnly yes
  HostKeyAlias github.com
  {{- if $isDarwin }}
  AddKeysToAgent yes
  UseKeychain yes
  {{- else if $isWindows }}
  IdentityAgent //./pipe/openssh-ssh-agent
  {{- end }}
{{- end }}

Host {{ $codebergHost }}
  HostName {{ $codebergHost }}
  User git
  IdentityFile {{ $personalCodebergKey }}
  IdentitiesOnly yes
  {{- if $isDarwin }}
  AddKeysToAgent yes
  UseKeychain yes
  {{- else if $isWindows }}
  IdentityAgent //./pipe/openssh-ssh-agent
  {{- end }}

{{- if $isDarwin }}
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
